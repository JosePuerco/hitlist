{
  "name": "Hitlist – Stil A Studio",
  "mode": "dark",
  "color": {
    "bg": "#121212",
    "bg-scanner-from": "#2A2A2A",
    "bg-scanner-to": "#0C0C0C",
    "surface": "#1E1E1E",
    "surface-2": "#242424",
    "surface-3": "#2A2A2A",
    "line": "#2E2E2E",
    "line-input": "#333333",
    "switch-off": "#3A3A3A",
    "handle": "#444444",
    "text": "#FFFFFF",
    "text-2": "#B3B3B3",
    "text-3": "#A0A0A0",
    "accent": "#4ADE80",
    "on-accent": "#0B0B0B",
    "warning": "#F59E0B",
    "warning-bg": "#2A2416",
    "error": "#F87171",
    "error-bg": "#3A1E1E",
    "success-bg": "#1F3326",
    "overlay-opacity": 0.35
  },
  "font": {
    "family": "Figtree",
    "fallback": "system-ui, sans-serif",
    "weights": [400, 600, 700, 800],
    "numeric": "tabular-nums"
  },
  "type": {
    "year": { "size": 96, "weight": 800, "letterSpacing": -4, "lineHeight": 1 },
    "hero": { "size": 44, "weight": 800, "letterSpacing": -1.5, "lineHeight": 1.05 },
    "h1": { "size": 34, "weight": 800, "letterSpacing": -1 },
    "h2": { "size": 26, "weight": 800, "letterSpacing": -0.5 },
    "wordmark": { "size": 24, "weight": 800, "letterSpacing": -0.5 },
    "title": { "size": 26, "weight": 700 },
    "body-lg": { "size": 17, "weight": 400, "lineHeight": 1.45 },
    "body": { "size": 16, "weight": 400, "lineHeight": 1.45 },
    "small": { "size": 15, "weight": 400 },
    "chip": { "size": 13, "weight": 600 },
    "section": { "size": 13, "weight": 700, "letterSpacing": 0.5, "transform": "uppercase" },
    "hint": { "size": 12, "weight": 400 }
  },
  "radius": {
    "pill": 28,
    "hero-card": 24,
    "card": 20,
    "list-card": 18,
    "sheet": 28,
    "tile": 20,
    "stepper": 16,
    "input": 14,
    "chip": 999
  },
  "size": {
    "button-height": 56,
    "touch-min": 44,
    "icon-button-header": 44,
    "icon-button-player": 56,
    "play-button": 80,
    "finder": 260,
    "switch": [52, 32]
  },
  "space": {
    "screen-top": 56,
    "screen-side": 20,
    "screen-bottom": 32,
    "gap": 20,
    "gap-sm": 12,
    "gap-xs": 8
  },
  "motion": {
    "press": { "scale": 0.93, "durationMs": 150, "easing": "cubic-bezier(.3,1.6,.5,1)" },
    "equalizer": { "durationMs": 1100, "minHeight": 18, "maxHeight": 92, "bars": 7, "delaysS": [0, -0.2, -0.5, -0.1, -0.7, -0.35, -0.6] },
    "reveal-card": { "durationMs": 550, "easing": "cubic-bezier(.2,1.4,.4,1)", "from": "scale(.94) rotateY(90deg)" },
    "reveal-items": { "durationMs": 600, "riseY": 16, "delaysS": [0.05, 0.18, 0.26, 0.36] },
    "sheet": { "durationMs": 500, "easing": "cubic-bezier(.2,1.2,.3,1)" },
    "shake": { "durationMs": 500 },
    "scan-line": { "durationMs": 2000 },
    "finder-breathe": { "durationMs": 2400, "scale": 1.03 },
    "ping": { "durationMs": 1600, "scale": 3 },
    "stepper-bump": { "durationMs": 250, "from": 0.85 },
    "success-pop": { "durationMs": 500 },
    "switch": { "durationMs": 300 },
    "step-slide": { "durationMs": 450, "fromX": 24 },
    "reduced-motion": "Alle Animationen aus, Zustandswechsel sofort"
  }
}
